<?xml version="1.0" encoding="UTF-8"?>
<!-- Keys mirror Resources' preferences (DESIGN.md §2.1 and §11).
     Keys marked "Proccoli" are additions for the swappable GPU page. -->
<schemalist>
  <enum id="io.github.mamadingleberry.Proccoli.TemperatureUnit">
    <value nick="celsius" value="0"/>
    <value nick="fahrenheit" value="1"/>
    <value nick="kelvin" value="2"/>
  </enum>
  <enum id="io.github.mamadingleberry.Proccoli.TopMetric">
    <value nick="cpu" value="0"/>
    <value nick="memory" value="1"/>
  </enum>
  <enum id="io.github.mamadingleberry.Proccoli.Base">
    <value nick="decimal" value="0"/>
    <value nick="binary" value="1"/>
  </enum>
  <enum id="io.github.mamadingleberry.Proccoli.UpdateInterval">
    <value nick="1-second" value="1"/>
    <value nick="2-seconds" value="2"/>
    <value nick="3-seconds" value="3"/>
    <value nick="5-seconds" value="5"/>
    <value nick="10-seconds" value="10"/>
  </enum>
  <enum id="io.github.mamadingleberry.Proccoli.RefreshSpeed">
    <value nick="very-slow" value="0"/>
    <value nick="slow" value="1"/>
    <value nick="normal" value="2"/>
    <value nick="fast" value="3"/>
    <value nick="very-fast" value="4"/>
  </enum>
  <enum id="io.github.mamadingleberry.Proccoli.GraphTimeRange">
    <value nick="30-seconds" value="30"/>
    <value nick="1-minute" value="60"/>
    <value nick="2-minutes" value="120"/>
    <value nick="5-minutes" value="300"/>
    <value nick="10-minutes" value="600"/>
    <value nick="30-minutes" value="1800"/>
    <value nick="1-hour" value="3600"/>
    <value nick="6-hours" value="21600"/>
    <value nick="1-day" value="86400"/>
  </enum>
  <enum id="io.github.mamadingleberry.Proccoli.ColorScheme">
    <value nick="system" value="0"/>
    <value nick="light" value="1"/>
    <value nick="dark" value="2"/>
    <value nick="sand" value="3"/>
    <value nick="sky" value="4"/>
    <value nick="twilight" value="5"/>
    <value nick="midnight" value="6"/>
  </enum>
  <enum id="io.github.mamadingleberry.Proccoli.Palette">
    <value nick="system" value="0"/>
    <value nick="gnome" value="1"/>
    <value nick="tango" value="2"/>
    <value nick="solarized" value="3"/>
    <value nick="linux" value="4"/>
    <value nick="xterm" value="5"/>
    <value nick="rxvt" value="6"/>
    <value nick="nord" value="7"/>
  </enum>
  <enum id="io.github.mamadingleberry.Proccoli.LogLevel">
    <value nick="off" value="0"/>
    <value nick="error" value="1"/>
    <value nick="warning" value="2"/>
    <value nick="info" value="3"/>
    <value nick="debug" value="4"/>
  </enum>
  <enum id="io.github.mamadingleberry.Proccoli.SidebarStyle">
    <value nick="full" value="0"/>
    <value nick="icons" value="1"/>
  </enum>
  <enum id="io.github.mamadingleberry.Proccoli.MeterType">
    <value nick="progress-bar" value="0"/>
    <value nick="graph" value="1"/>
  </enum>

  <schema id="io.github.mamadingleberry.Proccoli" path="/io/github/mamadingleberry/Proccoli/">
    <!-- Window -->
    <key name="window-width" type="i">
      <default>1000</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>700</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window is maximized</summary>
    </key>

    <!-- General: units -->
    <key name="base" enum="io.github.mamadingleberry.Proccoli.Base">
      <default>'decimal'</default>
      <summary>Data unit prefix</summary>
    </key>
    <key name="network-bits" type="b">
      <default>false</default>
      <summary>Show network speeds in bits per second</summary>
    </key>
    <key name="temperature-unit" enum="io.github.mamadingleberry.Proccoli.TemperatureUnit">
      <default>'celsius'</default>
      <summary>Temperature unit</summary>
    </key>

    <!-- General: user interface -->
    <key name="lightweight" type="b">
      <default>false</default>
      <summary>Lightweight mode: as little memory as possible</summary>
      <description>Applies at the next start. Pages are built when visited, the Overview is a list, and charts, icons and GPU detail sources are kept to a minimum.</description>
    </key>
    <key name="update-interval" enum="io.github.mamadingleberry.Proccoli.UpdateInterval">
      <default>'1-second'</default>
      <summary>How often Proccoli takes readings</summary>
      <description>Every device, the process list and the history; never faster than once a second.</description>
    </key>
    <key name="refresh-speed" enum="io.github.mamadingleberry.Proccoli.RefreshSpeed">
      <default>'normal'</default>
      <summary>Replaced by update-interval</summary>
      <description>Read once at start-up to carry an old choice over to update-interval, then reset.</description>
    </key>
    <key name="show-graph-grids" type="b">
      <default>false</default>
      <summary>Show graph grids</summary>
    </key>
    <key name="graph-time-range" enum="io.github.mamadingleberry.Proccoli.GraphTimeRange">
      <default>'1-minute'</default>
      <summary>How much time graphs show</summary>
      <description>Graphs keep this much history whatever the refresh speed; the number of data points follows.</description>
    </key>
    <key name="sidebar-details" type="b">
      <default>true</default>
      <summary>Show usage details in the sidebar</summary>
    </key>
    <key name="sidebar-description" type="b">
      <default>true</default>
      <summary>Show device descriptions in the sidebar</summary>
    </key>
    <key name="color-scheme" enum="io.github.mamadingleberry.Proccoli.ColorScheme">
      <default>'system'</default>
      <summary>Style: light, dark or tinted</summary>
      <description>"system" follows the desktop's light/dark preference; sand and sky are tinted light styles, twilight and midnight tinted dark ones.</description>
    </key>
    <key name="sidebar-order" type="as">
      <default>[]</default>
      <summary>Order of the sidebar entries below Apps and Processes</summary>
      <description>Page IDs; entries not listed go to their default place.</description>
    </key>
    <key name="sidebar-minimized" type="as">
      <default>[]</default>
      <summary>Sidebar entries shown with only their icon and name</summary>
    </key>
    <key name="sidebar-hidden-fields" type="a{sas}">
      <default>{}</default>
      <summary>Parts each sidebar entry hides</summary>
      <description>Page ID to hidden parts: name, description, usage, chart.</description>
    </key>
    <key name="log-level" enum="io.github.mamadingleberry.Proccoli.LogLevel">
      <default>'debug'</default>
      <summary>What the diagnostics log records (debug: everything)</summary>
    </key>
    <key name="history" type="b">
      <default>true</default>
      <summary>Keep a history of every reading</summary>
      <description>In ~/.local/state/proccoli/history.sqlite3, with times in UTC: every reading for history-detail-hours, then averages per minute for 30 days and per hour after that.</description>
    </key>
    <key name="history-max-size" type="u">
      <range min="16" max="4096"/>
      <default>512</default>
      <summary>Most the history may take on disk, in MiB (the oldest goes first)</summary>
    </key>
    <key name="history-detail-hours" type="u">
      <range min="1" max="168"/>
      <default>24</default>
      <summary>Hours every reading is kept before only per-minute averages remain</summary>
    </key>
    <key name="log-max-size" type="u">
      <range min="64" max="65536"/>
      <default>1024</default>
      <summary>Size of the log file in KiB (one older file is kept too)</summary>
    </key>
    <key name="log-performance-interval" type="u">
      <range min="0" max="1440"/>
      <default>10</default>
      <summary>Minutes between performance lines in the log (0: none)</summary>
    </key>
    <key name="show-graph-axes" type="b">
      <default>true</default>
      <summary>Axis labels and ticks on percentage graphs</summary>
    </key>
    <key name="sidebar-shown" type="b">
      <default>true</default>
      <summary>Show the sidebar on wide windows</summary>
      <description>Hidden from the main menu or with F9. Narrow windows always start with the sidebar folded away.</description>
    </key>
    <key name="sidebar-style" enum="io.github.mamadingleberry.Proccoli.SidebarStyle">
      <default>'full'</default>
      <summary>Sidebar style: full entries, or icons only</summary>
      <description>Icons only shows each entry's icon; hovering shows its name and usage. Hiding the sidebar keeps the style.</description>
    </key>
    <key name="overview-top-by" enum="io.github.mamadingleberry.Proccoli.TopMetric">
      <default>'cpu'</default>
      <summary>What ranks the Overview's top apps and processes</summary>
      <description>Processor use or memory.</description>
    </key>
    <key name="auth-at-launch" type="b">
      <default>true</default>
      <summary>Offer to authenticate at start-up</summary>
      <description>Ask once at start-up whether to unlock everything that needs administrator rights. Every page keeps its own button either way.</description>
    </key>
    <key name="palette" enum="io.github.mamadingleberry.Proccoli.Palette">
      <default>'system'</default>
      <summary>Color palette for graphs, meters and the accent color</summary>
    </key>
    <key name="sidebar-meter-type" enum="io.github.mamadingleberry.Proccoli.MeterType">
      <default>'graph'</default>
      <summary>Sidebar meter type</summary>
    </key>
    <key name="normalize-cpu-usage" type="b">
      <default>true</default>
      <summary>Show each app's and process's share of the whole processor</summary>
      <description>On: a process's usage is divided by the number of logical CPUs, so the Apps and Processes columns add up to the total. Off: one fully busy core is 100 %, as in top.</description>
    </key>
    <key name="show-logical-cpus" type="b">
      <default>false</default>
      <summary>Show usage of each logical CPU</summary>
    </key>

    <!-- Devices -->
    <key name="show-virtual-drives" type="b">
      <default>false</default>
      <summary>Show virtual drives</summary>
    </key>
    <key name="show-virtual-network-interfaces" type="b">
      <default>false</default>
      <summary>Show virtual network interfaces</summary>
    </key>

    <!-- Apps columns -->
    <key name="apps-show-memory" type="b"><default>true</default><summary>Apps: Memory column</summary></key>
    <key name="apps-show-cpu" type="b"><default>true</default><summary>Apps: Processor column</summary></key>
    <key name="apps-show-drive-read-speed" type="b"><default>true</default><summary>Apps: Drive Read column</summary></key>
    <key name="apps-show-drive-read-total" type="b"><default>false</default><summary>Apps: Drive Read Total column</summary></key>
    <key name="apps-show-drive-write-speed" type="b"><default>true</default><summary>Apps: Drive Write column</summary></key>
    <key name="apps-show-drive-write-total" type="b"><default>false</default><summary>Apps: Drive Write Total column</summary></key>
    <key name="apps-show-gpu" type="b"><default>true</default><summary>Apps: GPU column</summary></key>
    <key name="apps-show-gpu-memory" type="b"><default>true</default><summary>Apps: Video Memory column</summary></key>
    <key name="apps-show-encoder" type="b"><default>false</default><summary>Apps: Video Encoder column</summary></key>
    <key name="apps-show-decoder" type="b"><default>false</default><summary>Apps: Video Decoder column</summary></key>
    <key name="apps-show-swap" type="b"><default>false</default><summary>Apps: Swap column</summary></key>
    <key name="apps-show-combined-memory" type="b"><default>false</default><summary>Apps: Combined Memory column</summary></key>
    <key name="apps-sort-by" type="u"><default>0</default><summary>Apps: sort column</summary></key>
    <key name="apps-sort-by-ascending" type="b"><default>false</default><summary>Apps: sort ascending</summary></key>

    <!-- Processes -->
    <key name="detailed-priority" type="b"><default>false</default><summary>Show niceness values instead of priority names</summary></key>
    <key name="processes-show-id" type="b"><default>true</default><summary>Processes: Process ID column</summary></key>
    <key name="processes-show-user" type="b"><default>true</default><summary>Processes: User column</summary></key>
    <key name="processes-show-memory" type="b"><default>true</default><summary>Processes: Memory column</summary></key>
    <key name="processes-show-cpu" type="b"><default>true</default><summary>Processes: Processor column</summary></key>
    <key name="processes-show-drive-read-speed" type="b"><default>false</default><summary>Processes: Drive Read column</summary></key>
    <key name="processes-show-drive-read-total" type="b"><default>false</default><summary>Processes: Drive Read Total column</summary></key>
    <key name="processes-show-drive-write-speed" type="b"><default>false</default><summary>Processes: Drive Write column</summary></key>
    <key name="processes-show-drive-write-total" type="b"><default>false</default><summary>Processes: Drive Write Total column</summary></key>
    <key name="processes-show-gpu" type="b"><default>true</default><summary>Processes: GPU column</summary></key>
    <key name="processes-show-gpu-memory" type="b"><default>false</default><summary>Processes: Video Memory column</summary></key>
    <key name="processes-show-encoder" type="b"><default>false</default><summary>Processes: Video Encoder column</summary></key>
    <key name="processes-show-decoder" type="b"><default>false</default><summary>Processes: Video Decoder column</summary></key>
    <key name="processes-show-total-cpu-time" type="b"><default>false</default><summary>Processes: Total CPU Time column</summary></key>
    <key name="processes-show-user-cpu-time" type="b"><default>false</default><summary>Processes: User CPU Time column</summary></key>
    <key name="processes-show-system-cpu-time" type="b"><default>false</default><summary>Processes: System CPU Time column</summary></key>
    <key name="processes-show-priority" type="b"><default>false</default><summary>Processes: Priority column</summary></key>
    <key name="processes-show-swap" type="b"><default>false</default><summary>Processes: Swap column</summary></key>
    <key name="processes-show-combined-memory" type="b"><default>false</default><summary>Processes: Combined Memory column</summary></key>
    <key name="processes-show-commandline" type="b"><default>false</default><summary>Processes: Commandline column</summary></key>
    <key name="processes-sort-by" type="u"><default>0</default><summary>Processes: sort column</summary></key>
    <key name="processes-sort-by-ascending" type="b"><default>false</default><summary>Processes: sort ascending</summary></key>

    <!-- GPU (Proccoli) -->
    <key name="gpu-details-disabled" type="as">
      <default>[]</default>
      <summary>GPUs whose detailed statistics are turned off</summary>
      <description>PCI slots (for example "0000:00:02.0") of GPUs whose Details and Processes tabs should not start their vendor tool.</description>
    </key>
    <key name="gpu-view" type="s">
      <default>'overview'</default>
      <summary>The GPU page tab shown last</summary>
    </key>
    <key name="gpu-elevate" type="b">
      <default>false</default>
      <summary>Start detailed GPU statistics with administrator rights at launch</summary>
    </key>
    <key name="intel-gpu-top-interval" type="s">
      <default>''</default>
      <summary>Update interval of the Intel Details tab</summary>
      <description>An update-interval nick, or empty to follow the general update interval.</description>
    </key>
  </schema>
</schemalist>
